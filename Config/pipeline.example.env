# Runtime
PIPELINE_ENV=development
PIPELINE_LOG_LEVEL=debug
PIPELINE_BIND_HOST=127.0.0.1
PIPELINE_BIND_PORT=8080

# Storage
PIPELINE_DATABASE_URL=sqlite:///tmp/masterofdrums-pipeline.sqlite
PIPELINE_ARTIFACT_ROOT=./var/artifacts

# Worker
PIPELINE_WORKER_POLL_INTERVAL_MS=1000
PIPELINE_WORKER_BATCH_SIZE=10
PIPELINE_JOB_DEFAULT_MAX_ATTEMPTS=5

# Auth
PIPELINE_API_TOKEN=replace-me
PIPELINE_REQUIRE_AUTH=false

# Observability
PIPELINE_ENABLE_REQUEST_LOGGING=true
PIPELINE_ENABLE_METRICS=true
PIPELINE_TRACE_EXPORTER=none
