# Runtime
PIPELINE_ENV=development
PIPELINE_LOG_LEVEL=debug

# Database
PIPELINE_DATABASE_PATH=./var/masterofdrums-pipeline.sqlite
PIPELINE_AUTO_MIGRATE=true

# Worker
PIPELINE_WORKER_POLL_INTERVAL_MS=1000
PIPELINE_WORKER_BATCH_SIZE=10
PIPELINE_JOB_DEFAULT_MAX_ATTEMPTS=5
PIPELINE_JOB_RETRY_BASE_DELAY_MS=5000

# Storage
PIPELINE_ARTIFACT_ROOT=./var/artifacts

# Observability
PIPELINE_ENABLE_STRUCTURED_LOGGING=true
