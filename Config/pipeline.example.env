# Runtime
PIPELINE_ENV=development
PIPELINE_LOG_LEVEL=debug

# Database
PIPELINE_DATABASE_PATH=./var/masterofdrums-pipeline.sqlite
PIPELINE_AUTO_MIGRATE=true

# Worker
PIPELINE_WORKER_POLL_INTERVAL_SECONDS=1

# Storage
PIPELINE_ARTIFACT_ROOT=./var/artifacts

# Audio analysis
# Required placeholders: {input} and {output}
# Recommended: create a repo-local venv and keep analyzer commands pinned to it.
#   python3 -m venv .venv
#   source .venv/bin/activate
#   ./.venv/bin/python -m pip install --upgrade pip
#   ./.venv/bin/python -m pip install -r requirements.txt
#   brew install ffmpeg   # required for MP3/non-WAV validation
# Use the repo-local venv instead of Homebrew/global pip; otherwise installs may fail with
# externally-managed-environment or land outside the analyzer runtime you actually execute.
# Example wrapper command:
# PIPELINE_AUDIO_ANALYZER_COMMAND=./.venv/bin/python ./scripts/analyzer-wrapper.py --input {input} --output {output}
PIPELINE_AUDIO_ANALYZER_COMMAND=
# Optional wrapper/backend env passthrough (inherited by the worker process)
# Legacy single-backend mode still works:
# PIPELINE_ANALYZER_BACKEND_COMMAND=./.venv/bin/python ./scripts/beat-this-backend.py --input {input} --output {output}
# Preferred split config for the current real-backend rollout + safety fallback:
# PIPELINE_ANALYZER_PRIMARY_BACKEND_COMMAND=./.venv/bin/python ./scripts/hybrid-drum-events-backend.py --input {input} --output {output}
# PIPELINE_ANALYZER_TIMING_BACKEND_COMMAND=./.venv/bin/python ./scripts/beat-this-backend.py --input {input} --output {output}
# PIPELINE_ANALYZER_EVENT_BACKEND_COMMAND=./.venv/bin/python ./scripts/backend-analyzer.py --input {input} --output {output}
# PIPELINE_ANALYZER_EVENT_POLICY=optional
# PIPELINE_ANALYZER_FALLBACK_BACKEND_COMMAND=./.venv/bin/python ./scripts/backend-analyzer.py --input {input} --output {output}
# PIPELINE_ANALYZER_FALLBACK_POLICY=on-error-or-invalid
# PIPELINE_ANALYZER_VALIDATION_MODE=require-timing
# Optional future stage-2 transcription path once a richer event backend is ready:
# PIPELINE_ANALYZER_EVENT_BACKEND_COMMAND=./.venv/bin/python ./scripts/adtof-stage2-backend.py --input {input} --output {output}
# PIPELINE_ADTOF_BACKEND_COMMAND=python3 /opt/adtof/infer.py --input {input} --output {output}
# Alternate external backend example:
# PIPELINE_ANALYZER_PRIMARY_BACKEND_COMMAND=/Users/ken/dev/masterofdrums-pipeline/.venv/bin/python /Users/ken/dev/masterofdrums-pipeline/scripts/beat-this-backend.py --input {input} --output {output}
# Madmom fallback spike example:
# PIPELINE_ANALYZER_FALLBACK_BACKEND_COMMAND=./.venv/bin/python ./scripts/madmom-fallback-backend.py --input {input} --output {output} --beats-file ./scripts/fixtures/madmom-sample.beats.txt --downbeats-file ./scripts/fixtures/madmom-sample.beats.txt
# Optional beat_this tuning knobs:
# PIPELINE_BEAT_THIS_MODEL=final0
# PIPELINE_BEAT_THIS_DEVICE=auto
# PIPELINE_BEAT_THIS_DBN=false
# PIPELINE_BEAT_THIS_FLOAT16=false
# Optional: kill analyzer process if it runs too long
PIPELINE_AUDIO_ANALYZER_TIMEOUT_SECONDS=300
# Optional: if true, accept JSON printed to stdout when no {output} file was written
PIPELINE_AUDIO_ANALYZER_STDOUT_JSON=false
# Validation loop:
#   swift run MasterOfDrumsPipeline doctor-audio-analyzer
#   swift run MasterOfDrumsPipeline validate-audio-analyzer --source-uri file:///tmp/test.wav --source-type file --requested-by cli --output-path /tmp/audio-analysis.json
#   python3 ./scripts/test-analyzer-wrapper.py
#   python3 ./scripts/test-adtof-stage2-backend.py

# Observability
PIPELINE_ENABLE_STRUCTURED_LOGGING=true
